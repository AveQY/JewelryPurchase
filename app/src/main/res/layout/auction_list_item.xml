<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:background="@color/transparent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                tools:ignore="MissingConstraints">

                <ImageView
                    android:id="@+id/auction_mianImg"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/person_center_bg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="130dp"
                    android:background="@color/semi_transparent"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_gravity="left|center"
                        android:layout_marginStart="20dp"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/auction_userImg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/user_default" />

                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/auction_username"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:layout_marginLeft="15dp"
                        android:gravity="center|top|left"
                        android:text="@string/auction_username"
                        android:textColor="@color/white"
                        android:layout_weight="1"
                        android:textSize="21sp" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/auction_playBtu"
                        android:layout_width="90dp"
                        android:layout_height="36dp"
                        android:layout_gravity="left|center"
                        android:layout_marginEnd="20dp"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:background="@color/purple_500"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:text="@string/auction_onclickBtu"
                            android:textStyle="bold"/>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>


            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 专场标题 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/auction_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="拍卖名称"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- 时间信息行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/auction_overTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2025.02.26 22:30 结拍"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/auction_goodsNum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="拍品 46 件"
                        android:textColor="@color/black" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>